{
    "name": "dahersistema/domain-system",
    "description": "Kernel base para aplicações plugáveis",
    "version": "2.5.0",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "DomainSystem\\": "src/",
            "DomainSystem\\SystemApps\\": "src/SystemApps/",
            "DomainSystem\\Plugins\\": [
                "src/Plugins/",
                "src/Plugins/clinic_pack/bundled_plugins/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DomainSystem\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:arch": "phpunit --testsuite Architecture"
    }
}
