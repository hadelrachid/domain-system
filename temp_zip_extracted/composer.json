{
    "name": "dahersistema/domain-system",
    "description": "Kernel base para aplica\u00e7\u00f5es plug\u00e1veis",
    "type": "project",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "DomainSystem\\": "src/",
            "DomainSystem\\Plugins\\": [
                "src/Plugins/",
                "src/Plugins/clinic_pack/bundled_plugins/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DomainSystem\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}